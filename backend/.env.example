# Environment
APP_ENV=dev
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=*

# ── 数据库 ──────────────────────────────────
# SQLite（本地开发，默认）
DATABASE_URL=sqlite+aiosqlite:///./myweb.db
# PostgreSQL（生产环境）
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/myweb
# MySQL（生产环境）
# DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/myweb

# ── Redis（可选）─────────────────────────────
# 本地开发不配置 Redis，使用内存存储
# 生产环境取消注释并配置：
# REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
